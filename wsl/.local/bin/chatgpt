#!/usr/bin/env bash

set -euo pipefail

# WSLg exposes the Wayland socket under this runtime directory.  Selecting it
# explicitly avoids Electron opening an unrendered window through auto-detect.
export XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir

nohup /usr/bin/chatgpt --ozone-platform=wayland "$@" \
  </dev/null >/dev/null 2>&1 &
