#!/usr/bin/env bash
# Render the Mandelbrot dive in the given theme colours (see ../live-wallpaper
# and mandelbrot.c for how the loop and the keyframes work).
# Usage: make-video <output.mp4> <width> <height> <colors.toml>
set -euo pipefail

here=$(dirname "$(realpath "$0")")
output=$1
width=$2
height=$3
colors=$4
seconds=900
fps=30

# The minibrot the dive ends in, in seahorse valley, 1.5 million times smaller
# than the whole set: nucleus (re im), period, iteration limit, palette length
# in escape counts at the start.
minibrot=(-0.742995642096812 0.133572422256623 65 200000 30)

accents=()
for name in blue magenta cyan orange red; do
  accents+=("$(grep -m1 "^$name *=" "$colors" | grep -o '#[0-9a-fA-F]\{6\}')")
done

program=$(mktemp)
trap 'rm -f "$program"' EXIT
gcc -O3 -march=native -fopenmp "$here/mandelbrot.c" -o "$program" -lm

# Encode on the first GPU that is not NVIDIA's (the laptop's Intel, the
# desktop's Radeon): its VA-API driver does 10-bit HEVC. LIBVA_DRIVER_NAME is
# cleared so libva picks that GPU's own driver, whatever the session forces.
for render_node in /dev/dri/renderD*; do
  [[ $(basename "$(readlink -f "/sys/class/drm/${render_node##*/}/device/driver")") != nvidia ]] && break
done

# 10-bit HEVC keeps the dark glow free of banding. Fractal
# detail compresses poorly: QP 24 keeps the filaments crisp at a quarter of
# the size NeoWaves' QP 20 would take.
nice -n 10 "$program" "$width" "$height" "$seconds" "$fps" "${minibrot[@]}" "${accents[@]}" |
  env -u LIBVA_DRIVER_NAME ffmpeg -v error -y -vaapi_device "$render_node" \
    -f rawvideo -pix_fmt rgb48le -s "${width}x${height}" -r "$fps" -i - \
    -vf "scale=out_color_matrix=bt709:out_range=tv,format=p010le,hwupload" \
    -c:v hevc_vaapi -profile:v main10 -rc_mode CQP -qp 24 \
    -colorspace bt709 -color_primaries bt709 -color_trc bt709 -movflags +faststart -f mp4 "$output"
