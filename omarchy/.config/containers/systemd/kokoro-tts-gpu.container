[Unit]
Description=Kokoro FastAPI local TTS GPU

[Quadlet]
# Omarchy masks the wait-online services, so network-online.target never
# activates and the default network dependency would block startup forever.
DefaultDependencies=false

[Container]
Image=ghcr.io/remsky/kokoro-fastapi-gpu:latest
ContainerName=kokoro-tts
PublishPort=127.0.0.1:8880:8880
Environment=HOST=0.0.0.0
Environment=PORT=8880
Environment=USE_GPU=true
Environment=DEVICE_TYPE=cuda
Environment=DEFAULT_VOICE=af_heart
Environment=API_LOG_LEVEL=INFO
AddDevice=nvidia.com/gpu=all

[Service]
# Only the XPS has a GPU that beats the CPU; other machines run kokoro-tts-cpu.
ExecCondition=/usr/share/omarchy/bin/omarchy-hw-match "XPS 15 9520"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
